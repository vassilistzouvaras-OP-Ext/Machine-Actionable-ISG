FROM ghcr.io/open-webui/pipelines:main

# CUDA image. This variant is pinned to a Pascal-compatible PyTorch build so
# cards like the GTX 1080 (sm_61) can still run on GPU.
ARG TORCH_VERSION=2.3.1
ARG TORCHVISION_VERSION=0.18.1
ARG TORCHAUDIO_VERSION=2.3.1
ARG PYTORCH_CUDA_INDEX=https://download.pytorch.org/whl/cu118

ENV LD_LIBRARY_PATH=/usr/local/lib/python3.11/site-packages/nvidia/cuda_nvrtc/lib:/usr/local/lib/python3.11/site-packages/nvidia/cudnn/lib:${LD_LIBRARY_PATH}
RUN ln -sf /usr/local/lib/python3.11/site-packages/nvidia/cuda_nvrtc/lib/libnvrtc.so.11.2 \
           /usr/local/lib/python3.11/site-packages/nvidia/cuda_nvrtc/lib/libnvrtc.so

RUN pip uninstall -y \
    torch torchvision torchaudio torch-cpu \
    vllm xformers flashinfer-python compressed-tensors xgrammar || true && \
    pip cache purge && \
    pip install --no-cache-dir --force-reinstall \
    "numpy<2.3" \
    "torch==${TORCH_VERSION}" \
    "torchvision==${TORCHVISION_VERSION}" \
    "torchaudio==${TORCHAUDIO_VERSION}" \
    --index-url "${PYTORCH_CUDA_INDEX}" && \
    pip install --no-cache-dir \
    "transformers>=4.38.0" \
    "tokenizers>=0.21,<0.22" \
    sentence-transformers \
    langchain \
    langchain-community \
    langchain-huggingface \
    langchain-text-splitters \
    langchain-core \
    faiss-cpu \
    rank_bm25 \
    pypdf \
    openai \
    accelerate \
    mineru \
    ftfy \
    pyclipper \
    playwright

RUN echo 'Acquire::AllowInsecureRepositories "true";' > /etc/apt/apt.conf.d/99bypass && \
    echo 'Acquire::AllowDowngradeToInsecureRepositories "true";' >> /etc/apt/apt.conf.d/99bypass && \
    echo 'Acquire::Check-Valid-Until "false";' >> /etc/apt/apt.conf.d/99bypass && \
    echo 'APT::Get::AllowUnauthenticated "true";' >> /etc/apt/apt.conf.d/99bypass && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

RUN playwright install --with-deps chromium

RUN python -c "import torch; print('Torch version:', torch.__version__); print('Torch CUDA:', torch.version.cuda); print('CUDA available at build:', torch.cuda.is_available()); print('Torch arch list:', getattr(torch.cuda, 'get_arch_list', lambda: [])())"
